# Porta HTTP (padrão 3000)
PORT=3000
# Arquivo do SQLite; ":memory:" recria o banco e o seed a cada boot (padrão)
DB_FILE=:memory:
# Token exigido em "Authorization: Bearer <token>" nas rotas administrativas.
# Sem valor, /api/admin/financial-report e DELETE /api/users/:id respondem 403.
ADMIN_TOKEN=
# Chave do gateway de pagamento (o gateway atual é simulado; nunca versionar o valor)
PAYMENT_GATEWAY_KEY=
# error | warn | info | debug
LOG_LEVEL=info
