# Copie para .env (ou exporte no shell) e ajuste. Nenhuma variável é obrigatória para rodar localmente.

# Servidor
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=0

# Chave de assinatura do Flask. Sem ela, uma chave aleatória é gerada a cada boot.
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Token exigido no cabeçalho X-Admin-Token por POST /admin/reset-db.
# Vazio = rota administrativa desabilitada (403).
ADMIN_TOKEN=

# Banco SQLite
DATABASE_PATH=loja.db

# Origens permitidas no CORS, separadas por vírgula (* = qualquer origem)
CORS_ORIGINS=*

# Rótulo devolvido em /health
APP_ENV=producao
