# Copie para .env e ajuste. Nenhum valor aqui é segredo real.

# Servidor (python app.py)
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=0
LOG_LEVEL=INFO

# Assina os tokens do /login. Sem valor, uma chave aleatória é gerada a cada boot.
# Gere uma com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Validade do token, em segundos (padrão 8 horas)
TOKEN_MAX_AGE=28800

# Banco (padrão: SQLite em instance/tasks.db)
DATABASE_URL=sqlite:///tasks.db

# Origens liberadas para CORS, separadas por vírgula. Vazio = CORS desligado.
CORS_ORIGINS=

# E-mail (NotificationService)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Senha única para os usuários do seed.py (opcional; sem valor, valem as senhas de desenvolvimento do seed)
SEED_PASSWORD=
